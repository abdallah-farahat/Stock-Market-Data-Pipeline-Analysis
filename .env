# Apache Airflow environment configuration
# Stock Market Data Pipeline

# Docker image configuration
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.5
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Additional Python packages for stock market data pipeline
_PIP_ADDITIONAL_REQUIREMENTS=yfinance>=0.2.28 pandas>=2.0.0 requests>=2.31.0 sqlalchemy>=2.0.0 psycopg2-binary>=2.9.0 apache-airflow-providers-postgres>=5.0.0 apache-airflow-providers-http>=4.0.0

# PostgreSQL configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow core configuration
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Security (for development only - change in production)
AIRFLOW__CORE__FERNET_KEY=
